# ---------------------------------------------------------------------------
# PactRail environment variables
# Copy to .env.local only if you need live mode or optional AI extraction.
# Never commit real secrets or private keys.
# ---------------------------------------------------------------------------

# "base-sepolia" (default) or "local"
NEXT_PUBLIC_DEFAULT_CHAIN=base-sepolia

# Base Sepolia
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_SEPOLIA_ESCROW=
NEXT_PUBLIC_BASE_SEPOLIA_TOKEN=
NEXT_PUBLIC_BASE_SEPOLIA_TOKEN_SYMBOL=pUSDC
NEXT_PUBLIC_BASE_SEPOLIA_TOKEN_DECIMALS=6

# Local Anvil (scripts/deploy-local.sh writes these automatically)
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_LOCAL_ESCROW=
NEXT_PUBLIC_LOCAL_TOKEN=
NEXT_PUBLIC_LOCAL_TOKEN_SYMBOL=pUSDC
NEXT_PUBLIC_LOCAL_TOKEN_DECIMALS=6

# Optional server-side analysis provider. Leave blank for labelled rules fallback.
OPENAI_API_KEY=
PACTRAIL_AI_BASE_URL=
PACTRAIL_AI_MODEL=gpt-4o-mini

# CCIP adapter deployment only, read by forge scripts. Do not set these in the web app.
# CCIP_ROUTER=
# CCIP_LINK=
# CCIP_SOURCE_CHAIN_SELECTOR=
# CCIP_SOURCE_SENDER=
# CCIP_DESTINATION_CHAIN_SELECTOR=
# CCIP_RECEIVER=
