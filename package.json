{
  "name": "pactrail",
  "version": "0.1.0",
  "private": true,
  "description": "Turn commercial agreements into verifiable milestone payments.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "contracts:build": "cd contracts && bash ../scripts/forge.sh build",
    "contracts:test": "cd contracts && bash ../scripts/forge.sh test",
    "chain:node": "bash scripts/anvil.sh --host 127.0.0.1 --port 8545",
    "chain:deploy": "bash scripts/deploy-local.sh",
    "chain:smoke": "tsx scripts/chain-smoke.ts"
  },
  "dependencies": {
    "@chainlink/contracts-ccip": "2.0.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@openzeppelin/contracts": "5.4.0",
    "@tanstack/react-query": "5.105.0",
    "clsx": "2.1.1",
    "lucide-react": "1.65.0",
    "next": "15.5.28",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.4.0",
    "viem": "2.57.13",
    "wagmi": "2.19.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.22",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
